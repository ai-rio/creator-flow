{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "url": "",
      "headers": {},
      "oauthScopes": ["openid", "email", "profile", "offline_access"],
      "command": "uvx",
      "args": ["--from", "git+https://github.com/oraios/serena", "serena-mcp-server", "--context", "ide-assistant"],
      "env": {},
      "timeout": 120000,
      "disabled": false
    },
    "shadcn": {
      "type": "stdio",
      "url": "",
      "headers": {},
      "oauthScopes": ["openid", "email", "profile", "offline_access"],
      "command": "bunx",
      "args": ["shadcn@latest", "mcp"],
      "env": {},
      "timeout": 120000,
      "disabled": false
    },
    "playwright": {
      "type": "stdio",
      "url": "",
      "headers": {},
      "oauthScopes": ["openid", "email", "profile", "offline_access"],
      "command": "bunx",
      "args": ["@playwright/mcp@latest"],
      "env": {},
      "timeout": 120000,
      "disabled": false
    }
  }
}
